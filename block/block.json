{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waymorphic/map",
	"title": "Waymorphic Map",
	"category": "embed",
	"icon": "location-alt",
	"description": "A free OpenStreetMap vector map with markers. No API key.",
	"keywords": [ "map", "openstreetmap", "location", "marker", "maplibre" ],
	"textdomain": "wp-free-maps",
	"attributes": {
		"lat": { "type": "number" },
		"lng": { "type": "number" },
		"zoom": { "type": "number" },
		"mapStyle": { "type": "string", "default": "" },
		"height": { "type": "string", "default": "" },
		"markers": {
			"type": "array",
			"default": [],
			"items": { "type": "object" }
		},
		"shapes": {
			"type": "array",
			"default": [],
			"items": { "type": "object" }
		},
		"cluster": { "type": "boolean", "default": false },
		"list": { "type": "boolean", "default": false },
		"locator": { "type": "boolean", "default": false },
		"unit": { "type": "string", "default": "km" },
		"filter": { "type": "boolean", "default": false },
		"directions": { "type": "boolean", "default": false },
		"locate": { "type": "boolean", "default": false },
		"animation": { "type": "string", "default": "" },
		"controls": { "type": "boolean", "default": true },
		"scrollZoom": { "type": "boolean", "default": false },
		"interactive": { "type": "boolean", "default": true },
		"title": { "type": "string", "default": "" }
	},
	"supports": {
		"align": [ "wide", "full" ],
		"html": false,
		"spacing": { "margin": true }
	},
	"editorScript": "waymorphic-map-editor",
	"editorStyle": "waymorphic-map-editor",
	"script": "waymorphic-map",
	"style": "waymorphic-map"
}
